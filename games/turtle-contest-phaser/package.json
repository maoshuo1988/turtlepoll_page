  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "jimp": "^1.6.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.59.4",
    "vite": "^5.4.0",
    "vitest": "^4.1.7"
  }
}
