    "axios": "^1.13.6",
    "dayjs": "^1.11.19",
    "framer-motion": "^12.35.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.575.0",
    "motion": "^12.40.0",
    "pixi.js": "^8.18.1",
    "react": "^19.2.0",
    "react-countup": "^6.5.3",
